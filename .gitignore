# ---- 依赖 ----
node_modules/

# ---- 构建产物 ----
dist/
dist-ssr/
*.local

# Vite / TypeScript 缓存
.vite/
*.tsbuildinfo

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 环境变量（本地覆盖，勿提交） ----
.env
.env.*
!.env.example

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Capacitor / Android ----
# （Android 工程内还有更细的 android/.gitignore，这里只补充通用项）
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/

# 由 `npx cap sync` 从 dist/ 拷贝而来，不提交
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# 签名文件，禁止入库
*.jks
*.keystore
